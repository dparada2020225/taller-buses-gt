FROM node:20-alpine

# OpenSSL requerido por Prisma
RUN apk add --no-cache openssl

WORKDIR /app

# Instalar dependencias primero (capa cacheada)
COPY package*.json ./
RUN npm install

# Copiar entrypoint
COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 3000 5555

ENTRYPOINT ["./docker-entrypoint.sh"]
