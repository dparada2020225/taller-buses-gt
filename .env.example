# ─── Base de datos ───────────────────────────────────────────────────────────
# En Docker el host es "postgres" (nombre del servicio), no localhost
DATABASE_URL="postgresql://taller:taller123@postgres:5432/taller_buses_gt"

# PostgreSQL (usado por docker-compose)
POSTGRES_USER=taller
POSTGRES_PASSWORD=taller123
POSTGRES_DB=taller_buses_gt

# ─── Auth (better-auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_chars
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (emails) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tallerbusesgt.com

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
